# ============================================================
# DEPLOYMENT MODELS — KEEP REQUIRED MODELS IN GIT
# ============================================================

# Ignore ML model/checkpoint files by default
*.pt
*.ckpt

# Keep backend model directory
!backend/models/

# Keep all YOLO deployment models
!backend/models/*.pt

# Keep the production Transformer shot-classification checkpoint
!backend/models/cricket_model_transformer.ckpt


# ============================================================
# FRONTEND PUBLIC ASSETS — KEEP IN GIT
# ============================================================

!frontend/public/
!frontend/public/*.mp4
!frontend/public/*.svg


# ============================================================
# BACKEND SOURCE — EXPLICITLY KEEP
# ============================================================

!backend/
!backend/main.py
!backend/requirements.txt
!backend/src/
!backend/src/**/*.py


# ============================================================
# FRONTEND SOURCE — EXPLICITLY KEEP
# ============================================================

!frontend/src/
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/src/**/*.js
!frontend/src/**/*.jsx